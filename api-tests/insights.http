{
  "prompt": "What needs attention?"
}


### Another question to test conversation history
POST {{baseUrl}}/api/insights/ask
Content-Type: application/json
Cookie: fintech_wallet_session={{sessionCookie}}

{
  "history": [
    {
      "role": "user",
      "content": "Which transactions need attention?"
    },
    {
      "role": "assistant",
      "content": "There is a pending payment."
    }
  ],
  "prompt": "Can you explain why?"
}