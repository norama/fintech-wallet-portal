@baseUrl = http://localhost:3000
@sessionCookie = 22222222-2222-2222-2222-222222222222

##############
### WALLETS ###
##############

### List all wallets
GET {{baseUrl}}/api/wallets
Cookie: fintech_wallet_session={{sessionCookie}}

# Verify response shape includes isPrimary on each item:
# { "items": [{ ..., "isPrimary": true|false }, ...], "summary": { ... } }

### List wallets — check isPrimary per currency (expect exactly one isPrimary:true per currency group)
GET {{baseUrl}}/api/wallets?currency=EUR
Cookie: fintech_wallet_session={{sessionCookie}}

### List wallets — check isPrimary per currency (expect exactly one isPrimary:true per currency group)
GET {{baseUrl}}/api/wallets?currency=CZK
Cookie: fintech_wallet_session={{sessionCookie}}

### List wallets — filter by currency USD
GET {{baseUrl}}/api/wallets?currency=USD
Cookie: fintech_wallet_session={{sessionCookie}}

### List wallets — filter by currency GBP
GET {{baseUrl}}/api/wallets?currency=GBP
Cookie: fintech_wallet_session={{sessionCookie}}

### List wallets — filter by status active
GET {{baseUrl}}/api/wallets?status=active
Cookie: fintech_wallet_session={{sessionCookie}}

### List wallets — filter by status limited
GET {{baseUrl}}/api/wallets?status=limited
Cookie: fintech_wallet_session={{sessionCookie}}

### List wallets — filter by status suspended
GET {{baseUrl}}/api/wallets?status=suspended
Cookie: fintech_wallet_session={{sessionCookie}}

### List wallets — search by name
GET {{baseUrl}}/api/wallets?search=operating
Cookie: fintech_wallet_session={{sessionCookie}}

### List wallets — combined search + currency filter
GET {{baseUrl}}/api/wallets?search=main&currency=EUR
Cookie: fintech_wallet_session={{sessionCookie}}

### List wallets — combined currency + status filter
GET {{baseUrl}}/api/wallets?currency=EUR&status=active
Cookie: fintech_wallet_session={{sessionCookie}}

### List wallets — unauthenticated (expect 401)
GET {{baseUrl}}/api/wallets

### List wallets — invalid currency (expect 400)
GET {{baseUrl}}/api/wallets?currency=XYZ
Cookie: fintech_wallet_session={{sessionCookie}}

### List wallets — invalid status (expect 400)
GET {{baseUrl}}/api/wallets?status=unknown
Cookie: fintech_wallet_session={{sessionCookie}}

### List wallets — primary wallets only (isPrimary=true)
GET {{baseUrl}}/api/wallets?isPrimary=true
Cookie: fintech_wallet_session={{sessionCookie}}

### List wallets — primary wallets only + currency filter
GET {{baseUrl}}/api/wallets?isPrimary=true&currency=EUR
Cookie: fintech_wallet_session={{sessionCookie}}

####################
### CREATE WALLET ###
####################

### Create wallet — valid EUR wallet
POST {{baseUrl}}/api/wallets
Content-Type: application/json
Cookie: fintech_wallet_session={{sessionCookie}}

{
  "name": "EUR Operating Account",
  "currency": "EUR"
}

### Create wallet — valid CZK wallet
POST {{baseUrl}}/api/wallets
Content-Type: application/json
Cookie: fintech_wallet_session={{sessionCookie}}

{
  "name": "CZK Payroll Account",
  "currency": "CZK"
}

### Create wallet — valid USD wallet
POST {{baseUrl}}/api/wallets
Content-Type: application/json
Cookie: fintech_wallet_session={{sessionCookie}}

{
  "name": "USD Reserve",
  "currency": "USD"
}

### Create wallet — valid GBP wallet
POST {{baseUrl}}/api/wallets
Content-Type: application/json
Cookie: fintech_wallet_session={{sessionCookie}}

{
  "name": "GBP Settlement",
  "currency": "GBP"
}

### Create wallet — missing name (expect 400)
POST {{baseUrl}}/api/wallets
Content-Type: application/json
Cookie: fintech_wallet_session={{sessionCookie}}

{
  "currency": "EUR"
}

### Create wallet — empty name (expect 400)
POST {{baseUrl}}/api/wallets
Content-Type: application/json
Cookie: fintech_wallet_session={{sessionCookie}}

{
  "name": "",
  "currency": "EUR"
}

### Create wallet — name too long — 81 characters (expect 400)
POST {{baseUrl}}/api/wallets
Content-Type: application/json
Cookie: fintech_wallet_session={{sessionCookie}}

{
  "name": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
  "currency": "EUR"
}

### Create wallet — invalid currency (expect 400)
POST {{baseUrl}}/api/wallets
Content-Type: application/json
Cookie: fintech_wallet_session={{sessionCookie}}

{
  "name": "Test Wallet",
  "currency": "XYZ"
}

### Create wallet — missing currency (expect 400)
POST {{baseUrl}}/api/wallets
Content-Type: application/json
Cookie: fintech_wallet_session={{sessionCookie}}

{
  "name": "Test Wallet"
}

### Create wallet — unauthenticated (expect 401)
POST {{baseUrl}}/api/wallets
Content-Type: application/json

{
  "name": "Test Wallet",
  "currency": "EUR"
}

#############################
### is_primary ASSIGNMENTS ###
#############################

# Rule: first wallet in a currency for an account → isPrimary: true
#       subsequent wallets in same currency       → isPrimary: false

### Create first wallet in a new currency (GBP) — expect isPrimary: true in response
# Run this only if the account has NO existing GBP wallets.
# Response: { ..., "isPrimary": true }
POST {{baseUrl}}/api/wallets
Content-Type: application/json
Cookie: fintech_wallet_session={{sessionCookie}}

{
  "name": "GBP Primary Wallet",
  "currency": "GBP"
}

### Create second wallet in same currency (GBP) — expect isPrimary: false in response
# Run after the previous request. The account now has a GBP wallet.
# Response: { ..., "isPrimary": false }
POST {{baseUrl}}/api/wallets
Content-Type: application/json
Cookie: fintech_wallet_session={{sessionCookie}}

{
  "name": "GBP Secondary Wallet",
  "currency": "GBP"
}

### Verify the GBP wallet list — expect exactly one isPrimary: true
# The first wallet (GBP Primary Wallet) should have isPrimary: true,
# the second (GBP Secondary Wallet) should have isPrimary: false.
GET {{baseUrl}}/api/wallets?currency=GBP
Cookie: fintech_wallet_session={{sessionCookie}}
